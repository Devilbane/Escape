extends RefCounted
## English texts: The Ashen Spire (see AshSpire). Merged into Lang.EN (see Lang.PARTS).

const EN := {
	"Dagegenlaufen, um das Grimoire an dich zu nehmen": "Run into it to take the grimoire",
	"Dagegenlaufen, um dich am Vorrat zu bedienen": "Run into it to help yourself to the supplies",
	"Dagegenlaufen, um deine Ausrüstung am Amboss auszubessern": "Run into it to mend your gear at the anvil",
	"Dagegenlaufen, um die Leiter nach oben zu steigen": "Run into it to climb the ladder up",
	"Dagegenlaufen, um mit dem Gefangenen zu reden": "Run into him to talk to the prisoner",
	"Du kennst keinen Zauber": "You know no spell",
	"Die Kraft sammelt sich noch (%d s)": "The power is still gathering (%d s)",
	"Das Grimoire der Stillen Flamme! Du beherrschst die Arkane Energie (Taste Z).": "The Grimoire of the Quiet Flame! You now command arcane energy (key Z).",
	"Du hast das Grimoire gestohlen! Mit Z schleuderst du Zauberblitze.": "You have stolen the grimoire! Press Z to hurl arcane bolts.",
