; Engine configuration file.

config_version=5

[application]

config/name="Escape!"
config/description="Entkomme aus dem Verlies."
config/icon="res://assets/logo/app_icon.png"
run/main_scene="res://scenes/main.tscn"
run/main_scene.launcher="res://scenes/launcher.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
boot_splash/bg_color=Color(0.05, 0.035, 0.08, 1)
boot_splash/show_image=false

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/viewport_width.launcher=960
window/size/viewport_height.launcher=540
window/size/resizable.launcher=false
window/size/mode=2
window/size/mode.launcher=0
window/size/initial_position_type=1
window/size/initial_position_type.launcher=1
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[physics]

common/physics_interpolation=true
common/physics_interpolation.launcher=false
common/physics_jitter_fix=0.0

[shader_globals]

relief_strength={
"type": "float",
"value": 1.0
}
hero_reveal={
"type": "vec4",
"value": Color(0, 0, 0, 0)
}
indoor_mask={
"type": "sampler2D",
"value": ""
}
indoor_area={
"type": "vec4",
"value": Color(0, 0, 0, 0)
}

[rendering]

renderer/rendering_method="forward_plus"
renderer/rendering_method.web="gl_compatibility"
rendering_device/driver.windows="d3d12"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
anti_aliasing/quality/msaa_3d=2
limits/opengl/max_lights_per_object=32
limits/opengl/max_renderable_lights=64
